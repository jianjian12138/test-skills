{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QA Test Cases Contract",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "case_type", "priority", "steps", "expected_result"],
    "properties": {
      "id": { "type": "string" },
      "title": { "type": "string" },
      "case_type": { "type": "string", "enum": ["functional", "api", "ui", "perf", "security"] },
      "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
      "preconditions": { "type": "string" },
      "steps": {
        "type": "array",
        "items": { "type": "string" }
      },
      "expected_result": { "type": "string" },
      "test_data": { "type": "object" }
    }
  }
}
