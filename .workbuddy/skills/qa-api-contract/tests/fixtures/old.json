{
  "openapi": "3.0.3",
  "info": { "title": "Demo", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com/v1" }],
  "components": {
    "securitySchemes": {
      "apiKeyAuth": { "type": "apiKey", "in": "header", "name": "X-Key" },
      "oauth": { "type": "oauth2", "flows": {} }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "name": { "type": "string", "nullable": true, "maxLength": 100 },
          "email": { "type": "string" },
          "status": { "type": "string", "enum": ["active", "banned", "pending"] },
          "score": { "type": "number", "format": "double" }
        }
      },
      "Payload": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" }, "maxItems": 10 },
          "legacy": { "type": "string" },
          "variant": { "oneOf": [{ "type": "string" }, { "type": "integer" }, { "type": "boolean" }] },
          "variant2": { "anyOf": [{ "type": "string" }, { "type": "integer" }] }
        }
      }
    }
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "parameters": [
          { "name": "page", "in": "query", "required": false, "schema": { "type": "integer", "format": "int64", "maximum": 1000 } },
          { "name": "sort", "in": "query", "required": false, "schema": { "type": "string", "enum": ["asc", "desc", "rand"] } },
          { "name": "legacyFlag", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "optDrop", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "moveMe", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "typeChange", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "headers": { "X-Total-Count": { "schema": { "type": "integer" } } },
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/User" } } }
          },
          "204": { "description": "empty" }
        }
      },
      "post": {
        "operationId": "createUser",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/Payload" } },
            "application/xml": { "schema": { "type": "object" } }
          }
        },
        "responses": { "201": { "description": "created" } }
      }
    },
    "/legacy": { "get": { "responses": { "200": { "description": "ok" } } } },
    "/orders": {
      "get": { "responses": { "200": { "description": "ok" } } },
      "delete": { "responses": { "200": { "description": "ok" } } }
    },
    "/secure": {
      "get": {
        "security": [{ "oauth": ["read"] }, { "apiKeyAuth": [] }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/secure2": {
      "get": {
        "security": [{ "apiKeyAuth": [] }],
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/free": { "get": { "security": [], "responses": { "200": { "description": "ok" } } } },
    "/external": {
      "get": {
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "https://other.example.com/schema.json#/Foo" } } } }
        }
      }
    }
  }
}
