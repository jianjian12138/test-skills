{
  "openapi": "3.0.1",
  "info": {"title": "Demo API", "version": "1.0.0"},
  "paths": {
    "/api/v1/login": {
      "post": {
        "summary": "用户登录",
        "parameters": [{"name":"X-Trace","in":"header","required":false,"description":"链路ID"}],
        "requestBody": {"content": {"application/json": {"schema": {
          "type":"object","required":["username","password"],
          "properties": {"username":{"type":"string","description":"手机号"},
                         "password":{"type":"string","description":"密码"}}
        }}}},
        "responses": {"200":{"description":"成功"},"401":{"description":"未授权"}}
      }
    },
    "/api/v1/user/{id}": {
      "get": {"summary":"获取用户","parameters":[
        {"name":"id","in":"path","required":true,"description":"用户ID"}],
        "responses":{"200":{"description":"OK"},"404":{"description":"不存在"}}}
    }
  }
}
